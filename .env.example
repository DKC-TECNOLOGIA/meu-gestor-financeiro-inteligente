# ============================================================================
# FINANCEIRO INTELIGENTE — VARIÁVEIS DE AMBIENTE (EXEMPLO)
# ============================================================================
# ATENÇÃO:
# - NUNCA coloque chaves privadas (SUPABASE_SERVICE_ROLE_KEY, OPENAI/GEMINI_API_KEY,
#   PLUGGY_CLIENT_SECRET) em variáveis com prefixo EXPO_PUBLIC_.
# - Variáveis EXPO_PUBLIC_ são embutidas no binário Android e públicas por design
#   (protegidas exclusivamente pelo Row Level Security - RLS do PostgreSQL).

# --- Cliente Mobile (Expo) ---
EXPO_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anon-publica-jwt"
EXPO_PUBLIC_DEFAULT_TIMEZONE="America/Bahia"
EXPO_PUBLIC_DEFAULT_CURRENCY="BRL"
EXPO_PUBLIC_DEFAULT_LOCALE="pt-BR"

# --- Backend / Supabase Edge Functions (Configuradas via `supabase secrets set`) ---
# SUPABASE_SERVICE_ROLE_KEY="jamais-expor-no-cliente"
# AI_PROVIDER_API_KEY="jamais-expor-no-cliente"
# AI_MODEL_NAME="gemini-2.5-flash"
# OPEN_FINANCE_PROVIDER="pluggy"
# OPEN_FINANCE_CLIENT_ID="jamais-expor-no-cliente"
# OPEN_FINANCE_CLIENT_SECRET="jamais-expor-no-cliente"
# OPEN_FINANCE_WEBHOOK_SECRET="jamais-expor-no-cliente"
