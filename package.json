    "@types/react": "~19.3.0",
    "ajv": "^8.17.1",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "jest": "~30.5.2",
    "prettier": "^3.5.1",
    "ts-jest": "^29.2.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.24.0"
