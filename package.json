    "expo": "~52.0.37",
    "expo-camera": "~16.0.16",
    "expo-constants": "~17.0.7",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.11",
    "expo-font": "~13.0.4",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.17",
    "expo-secure-store": "~14.0.1",
    "expo-sharing": "~13.0.1",
