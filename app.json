{
  "expo": {
    "name": "Financeiro Inteligente",
    "slug": "financeiro-inteligente",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "financeirointeligente",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.dkctech.financeirointeligente",
      "infoPlist": {
        "NSCameraUsageDescription": "Permita o acesso à câmera para ler o QR Code de notas fiscais (NFC-e)."
      }
    },
    "android": {
      "package": "br.com.dkctech.financeirointeligente",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o acesso à câmera para ler o QR Code de notas fiscais (NFC-e)."
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
